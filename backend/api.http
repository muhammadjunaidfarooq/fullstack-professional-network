# Manual API requests for the VS Code "REST Client" extension.
# 1. Run the backend (npm run dev).
# 2. Send the "login" request and copy the token into @token below.

@baseUrl = http://localhost:9090
@token = paste-token-here

### Health check
GET {{baseUrl}}/api/health

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "username": "testuser",
  "email": "test@example.com",
  "password": "password123"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Current user + profile
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Update professional profile
PATCH {{baseUrl}}/api/users/me/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPost": "Software Engineer",
  "location": "Lahore, Pakistan",
  "bio": "Full-stack developer.",
  "skills": ["React", "Node.js", "MongoDB"],
  "pastWork": [{ "company": "Tech Corp", "position": "Intern", "years": "2024 - 2025" }],
  "education": [{ "school": "University A", "degree": "BS", "fieldOfStudy": "Software Engineering", "years": "2022 - 2026" }]
}

### Search people
GET {{baseUrl}}/api/users?search=engineer&page=1&limit=12
Authorization: Bearer {{token}}

### View a profile by username
GET {{baseUrl}}/api/users/testuser
Authorization: Bearer {{token}}

### Feed (paginated)
GET {{baseUrl}}/api/posts?page=1&limit=10
Authorization: Bearer {{token}}

### Create a text post
POST {{baseUrl}}/api/posts
Authorization: Bearer {{token}}
Content-Type: application/json

{ "body": "Hello from the REST client!" }

### My connections
GET {{baseUrl}}/api/connections
Authorization: Bearer {{token}}

### Pending requests I received
GET {{baseUrl}}/api/connections/requests?type=received
Authorization: Bearer {{token}}

### Logout (revokes this token)
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{token}}
