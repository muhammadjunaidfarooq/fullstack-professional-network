# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (MongoDB Atlas or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/professional-network

# Port the API listens on (Render/Railway set PORT automatically)
PORT=9090

# Frontend URL(s) allowed by CORS, comma-separated, no trailing slash
CLIENT_ORIGIN=http://localhost:3000

# development | production | test
NODE_ENV=development

# How many days a login session stays valid
SESSION_TTL_DAYS=7

# Set to 1 when running behind one reverse proxy (Render, Railway, Fly.io)
# so rate limiting sees the real client IP
TRUST_PROXY=0

# Optional: MongoDB server used by `npm test` (defaults to mongodb://127.0.0.1:27017).
# Tests create and drop temporary databases named pn_test_*.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017
